#!/bin/bash
#
# Runs on the docker host after app settings are saved.
#
# The Collabora Online docker image is distroless: it contains no shell, so
# settings cannot be applied by a script running inside the container.
# Instead, all settings reach coolwsd as container environment variables
# (coolwsd is started with --use-env-vars), and docker fixes the environment
# at container creation time. Recreate the container so that changed
# settings take effect; "univention-app reinitialize" keeps the current
# settings values.
#
# $1 is the action: install, upgrade, settings or remove. Install and
# upgrade already (re)create the container with the current settings.

# The restart notice at the top of the settings page is a read-only Status
# setting: its localized Description is the visible text, and the stored
# value is an invisible placeholder that only makes the form render the
# widget - it must exist, so keep the UCR variable populated.
ucr set collabora/settings/note='&nbsp;'

# coolwsd only allows outgoing connections to well-known AI provider
# hosts and to private/loopback addresses; any other AI endpoint must be
# in the net.lok_allow allowlist, which the env file feeds from this UCR
# variable. Extract the host from the configured AI base URL and escape
# the regex metacharacters (the allowlist entries are regexes).
aiurl="$(ucr get collabora/ai/apiurl)"
aihost="${aiurl#*://}"
aihost="${aihost%%/*}"
aihost="${aihost%%:*}"
aihost="$(printf '%s' "$aihost" | sed 's/[][*^$()+?{}|\\.]/\\&/g')"
if [ -n "$aihost" ]; then
    ucr set collabora/ai/allowhost="$aihost"
else
    ucr unset collabora/ai/allowhost
fi

if [ "$1" = "settings" ]; then
    univention-app reinitialize collabora
fi

exit 0
