[collabora/settings/note]
Type = Status
Description = Changing any setting restarts the app.
Description[de] = Jede Änderung an den Einstellungen startet die App neu.
InitialValue = &nbsp;
Show = Install, Settings
Scope = outside

[username]
Description[de] = Benutzername für den Zugriff auf CODE Admin Console
Description = User name for accessing CODE Admin Console
Type = String
InitialValue = admin
Required = True
Show = Install, Settings

[password]
Description[de]=Passwort für den Zugriff auf CODE Admin Console
Description=Password for accessing CODE Admin Console
Type = Password
InitialValue = univention
Required = True
Show = Install, Settings

[collabora/ai]
Type = Bool
InitialValue = false
Description = Enable AI features. Users can then configure their own OpenAI-compatible endpoint in the settings dialog.
Description[de] = KI-Funktionen aktivieren. Benutzer können dann einen eigenen OpenAI-kompatiblen Endpunkt im Einstellungsdialog konfigurieren.
Show = Install, Settings
Group = AI
Group[de] = KI

[collabora/ai/apiurl]
Type = String
Description = Central AI provider base URL for all users (e.g. http://localhost:11434 for local Ollama, or https://api.openai.com). Must support the /v1/chat/completions endpoint.
Description[de] = Zentrale Basis-URL des KI-Anbieters für alle Benutzer (z.B. http://localhost:11434 für lokales Ollama oder https://api.openai.com). Muss den Endpunkt /v1/chat/completions unterstützen.
Show = Install, Settings
Scope = inside, outside
Group = AI
Group[de] = KI

[collabora/ai/apikey]
Type = String
Description = API key for the central AI provider. May be left empty for self-hosted models without authentication.
Description[de] = API-Schlüssel für den zentralen KI-Anbieter. Kann für selbst gehostete Modelle ohne Authentifizierung leer bleiben.
Show = Install, Settings
Group = AI
Group[de] = KI

[collabora/ai/model]
Type = String
Description = AI model name (e.g. gpt-4o, llama3.1, qwen2.5). Editing the document with AI requires a model with native tool calling.
Description[de] = Name des KI-Modells (z.B. gpt-4o, llama3.1, qwen2.5). Das Bearbeiten des Dokuments mit KI erfordert ein Modell mit nativer Werkzeugaufruf-Unterstützung (tool calling).
Show = Install, Settings
Group = AI
Group[de] = KI

[collabora/accessibility]
Type = Bool
InitialValue = false
Description = Enable screen reader support (accessibility) for all users.
Description[de] = Unterstützung für Screenreader (Barrierefreiheit) für alle Benutzer aktivieren.
Show = Install, Settings
Group = Accessibility
Group[de] = Barrierefreiheit

[collabora/macros]
Type = Bool
InitialValue = false
Description = Allow execution of Basic and Python macros in documents. Only enable this if you trust the users and their documents.
Description[de] = Ausführung von Basic- und Python-Makros in Dokumenten erlauben. Aktivieren Sie dies nur, wenn Sie den Benutzern und ihren Dokumenten vertrauen.
Show = Install, Settings
Group = Security
Group[de] = Sicherheit

[collabora/languagetool/enabled]
Type = Bool
InitialValue = false
Description = Enable grammar checking with a LanguageTool or Duden Korrekturserver API; configure the URL below.
Description[de] = Grammatikprüfung über eine LanguageTool- oder Duden-Korrekturserver-API aktivieren; konfigurieren Sie die URL unten.
Show = Install, Settings
Group = LanguageTool
Group[de] = LanguageTool

[collabora/languagetool/baseurl]
Type = String
Description = LanguageTool API base URL, without the /check or /languages suffix (e.g. https://api.languagetoolplus.com/v2).
Description[de] = Basis-URL der LanguageTool-API, ohne den Zusatz /check oder /languages (z.B. https://api.languagetoolplus.com/v2).
Show = Install, Settings
Group = LanguageTool
Group[de] = LanguageTool

[collabora/languagetool/username]
Type = String
Description = LanguageTool or Duden account user name (premium accounts only).
Description[de] = Benutzername des LanguageTool- oder Duden-Kontos (nur für Premium-Konten).
Show = Install, Settings
Group = LanguageTool
Group[de] = LanguageTool

[collabora/languagetool/apikey]
Type = String
Description = LanguageTool or Duden API key (premium accounts only).
Description[de] = API-Schlüssel des LanguageTool- oder Duden-Kontos (nur für Premium-Konten).
Show = Install, Settings
Group = LanguageTool
Group[de] = LanguageTool

[collabora/languagetool/restprotocol]
Type = String
Description = REST protocol variant: leave empty for LanguageTool, enter 'duden' for a Duden Korrekturserver.
Description[de] = REST-Protokollvariante: für LanguageTool leer lassen, für einen Duden-Korrekturserver 'duden' eintragen.
Show = Install, Settings
Group = LanguageTool
Group[de] = LanguageTool

[collabora/deepl/enabled]
Type = Bool
InitialValue = false
Description = Enable translation with the DeepL API; configure URL and key below.
Description[de] = Übersetzung über die DeepL-API aktivieren; konfigurieren Sie URL und Schlüssel unten.
Show = Install, Settings
Group = DeepL
Group[de] = DeepL

[collabora/deepl/apiurl]
Type = String
Description = DeepL API URL (e.g. https://api-free.deepl.com/v2/translate).
Description[de] = URL der DeepL-API (z.B. https://api-free.deepl.com/v2/translate).
Show = Install, Settings
Group = DeepL
Group[de] = DeepL

[collabora/deepl/authkey]
Type = String
Description = Authentication key from your DeepL account.
Description[de] = Authentifizierungsschlüssel Ihres DeepL-Kontos.
Show = Install, Settings
Group = DeepL
Group[de] = DeepL

[collabora/fonts]
Type = String
Description = URL of a JSON file that lists additional fonts to install, e.g. the font list of the Nextcloud on this host: https://FQDN_OF_THIS_SERVER/nextcloud/apps/richdocuments/settings/fonts.json
Description[de] = URL einer JSON-Datei mit zusätzlich zu installierenden Schriftarten, z.B. die Schriftartenliste der Nextcloud auf diesem Rechner: https://FQDN_DIESES_SERVERs/nextcloud/apps/richdocuments/settings/fonts.json
Show = Install, Settings
Group = Fonts
Group[de] = Schriftarten
