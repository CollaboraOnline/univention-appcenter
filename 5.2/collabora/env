# Environment file for docker container creation. The @%@...@%@ references
# are resolved from the app settings when the container is created; coolwsd
# (started with --use-env-vars) reads the resulting variables at startup.

# Config overrides without a dedicated environment variable go into
# extra_params; docker only honours the last occurrence of a variable in an
# env file, so all overrides must stay on this one line.
extra_params=--o:ai.enabled=@%@collabora/ai@%@ --o:ai.api_url=@%@collabora/ai/apiurl@%@ --o:ai.api_key=@%@collabora/ai/apikey@%@ --o:ai.model=@%@collabora/ai/model@%@ --o:accessibility.enable=@%@collabora/accessibility@%@ --o:security.enable_macros_execution=@%@collabora/macros@%@ --o:languagetool.enabled=@%@collabora/languagetool/enabled@%@ --o:languagetool.base_url=@%@collabora/languagetool/baseurl@%@ --o:languagetool.user_name=@%@collabora/languagetool/username@%@ --o:languagetool.api_key=@%@collabora/languagetool/apikey@%@ --o:languagetool.rest_protocol=@%@collabora/languagetool/restprotocol@%@ --o:deepl.enabled=@%@collabora/deepl/enabled@%@ --o:deepl.api_url=@%@collabora/deepl/apiurl@%@ --o:deepl.auth_key=@%@collabora/deepl/authkey@%@ --o:remote_font_config.url=@%@collabora/fonts@%@
