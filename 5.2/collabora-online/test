def _prepare_file_view(chrome):
    i = 0
    if chrome.find_first('label#view-toggle'):
        while not chrome.find_first('label#view-toggle.icon-toggle-pictures'):
            i += 1
            if i > 20:
                break
            chrome.click_element('label#view-toggle')
    while chrome.find_first('th#headerDate span.icon-triangle-n'):
        i += 1
        if i > 20:
            break
        chrome.click_element('th#headerDate span.icon-triangle-n')


def _enter_text_in_collabora_owncloud(chrome, document_content):
    from selenium.webdriver import ActionChains

    time.sleep(10)
    # in UCS tabs are different, change to the last open tab
    chrome.change_tab(-1)
    chrome.driver.switch_to.frame(chrome.driver.find_element_by_xpath('//iframe[@id="loleafletframe"]'))
    try:
        element = chrome.driver.find_elements_by_css_selector('.vex-close')[0]
        ActionChains(chrome.driver).move_to_element_with_offset(element, -15, 15).click().perform()
    except IndexError:
        pass
    time.sleep(2)
    # send escape to close initial popup
    ActionChains(chrome.driver).send_keys(Keys.ESCAPE).perform()
    time.sleep(2)
    # click on document to edit file
    chrome.driver.find_element_by_xpath('//*[@id="main-document-content"]').click()
    time.sleep(2)
    chrome.send_keys(document_content)
    time.sleep(2)
    # save
    ActionChains(chrome.driver).key_down(Keys.CONTROL).send_keys('s').key_up(Keys.CONTROL).perform()
    time.sleep(2)
    chrome.driver.switch_to.default_content()
    chrome.close_tab()
    chrome.change_tab(-1)


def _enter_text_in_collabora_nextcloud(chrome, document_content):
    from selenium.webdriver.support import expected_conditions as EC
    from selenium.webdriver.support.ui import WebDriverWait as wait
    from selenium.webdriver.common.by import By
    from selenium.webdriver import ActionChains
    time.sleep(10)
    # send escape to close initial popup
    ActionChains(chrome.driver).send_keys(Keys.ESCAPE).perform()
    time.sleep(2)
    # wait(chrome.driver, 10).until(EC.frame_to_be_available_and_switch_to_it('richdocumentsframe'))
    # wait(chrome.driver, 10).until(EC.frame_to_be_available_and_switch_to_it('loleafletframe'))
    # get all iframes
    iframes = chrome.driver.find_elements_by_tag_name('iframe')
    for iframe in iframes:
        if 'collaboraframe' in iframe.get_attribute('id'):
            chrome.driver.switch_to.frame(iframe)
            break

    # time.sleep(1)
    # check if an error popup exists with "document cannot be saved, check permissions or contact your administrator"
    try:
        element = chrome.driver.find_elements_by_css_selector('.vex-close')[0]
        ActionChains(chrome.driver).move_to_element_with_offset(element, -15, 15).click().perform()
    except IndexError:
        pass
    chrome.enter_return()
    time.sleep(2)
    # click on document to edit file
    chrome.click_element("div[id='main-document-content']")
    # chrome.driver.find_element_by_xpath('//*[@id="main-document-content"]').click()
    time.sleep(1)
    chrome.send_keys(document_content)
    time.sleep(1)
    # save
    ActionChains(chrome.driver).key_down(Keys.CONTROL).send_keys('s').key_up(Keys.CONTROL).perform()
    time.sleep(1)
    wait(chrome.driver, 10).until(EC.element_to_be_clickable((By.ID, 'closebutton')))
    chrome.click_element('#closebutton')
    time.sleep(2)
    chrome.driver.switch_to.default_content()
    time.sleep(2)


