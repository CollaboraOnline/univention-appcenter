def test_nextcloud(chrome, users):
    with chrome.capture('collabora_nextcloud'):

        from selenium.webdriver.support import expected_conditions as EC
        from selenium.webdriver.support.ui import WebDriverWait as wait
        from selenium.webdriver.common.by import By
        from selenium.common.exceptions import TimeoutException

        user = users('collabora-2', {'nextcloudEnabled': True})
        document_title = ''.join(random.choice(string.ascii_uppercase) for _ in range(10))
        document_content = 'This is some test content...'
        chrome.goto_portal()
        time.sleep(10)
        chrome.reload()
        time.sleep(10)
        try:
            chrome.click_portal_tile(u'Nextcloud')
        except Exception:
            chrome.click_portal_tile(u'Nextcloud Hub')
        time.sleep(2)
        if chrome.find_first('.login-option:first-of-type'):
            chrome.click_element('.login-option:first-of-type')
        _login_nextcloud(chrome, user)
        # first run wizard
        try:
            wait(chrome.driver, 30).until(EC.element_to_be_clickable((By.ID, 'firstrunwizard')))
            chrome.driver.execute_script("document.getElementById('firstrunwizard').getElementsByTagName('button')[1].click()")
            time.sleep(5)
        except TimeoutException:
            pass
        # go to files
        element = chrome.driver.find_element_by_xpath("//li[@data-app-id='files']")
        element.click()
        time.sleep(15)
        _add_doc_nextcloud(chrome, document_title + '.odt')
        time.sleep(9)
        _prepare_file_view(chrome)
        _enter_text_in_collabora_nextcloud(chrome, document_content)
        _prepare_file_view(chrome)
        _use_document(chrome, document_title, '.odt', 'Download')
        path = pathlib.Path('~').expanduser() / 'Downloads' / '{}.odt'.format(document_title)
        with zipfile.ZipFile(str(path), 'r') as myzip:
            with myzip.open('content.xml') as myfile:
                assert document_content in str(myfile.read())


def test_owncloud(chrome, users):
    with chrome.capture('collabora_owncloud'):
        user = users('collabora-2', {'owncloudEnabled': True})
        document_title = ''.join(random.choice(string.ascii_uppercase) for _ in range(10))
        document_content = 'This is some test content...'
        chrome.goto_portal()
        chrome.click_portal_tile(u'ownCloud')
        time.sleep(2)
        _login(chrome, user)
        if chrome.find_first('#closeWizard'):
            # very first login of this user will show a tutorial
            chrome.click_element('#closeWizard')
            time.sleep(1)
        _add_doc_owncloud(chrome, document_title + '.odt')
        time.sleep(1)
        _prepare_file_view(chrome)
        _use_document(chrome, document_title, '.odt')
        _enter_text_in_collabora_owncloud(chrome, document_content)
        _prepare_file_view(chrome)
        _use_document(chrome, document_title, '.odt', 'Download')
        path = pathlib.Path('~').expanduser() / 'Downloads' / '{}.odt'.format(document_title)
        with zipfile.ZipFile(str(path), 'r') as myzip:
            with myzip.open('content.xml') as myfile:
                assert document_content in str(myfile.read())


