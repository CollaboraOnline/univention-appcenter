# Environment file for docker container creation. The @%@...@%@ references
# are resolved from the app settings (and host UCR) when the container is
# created; coolwsd (started with --use-env-vars) reads the resulting
# variables at startup.

# The 'domain' setting is a regex of WOPI hosts that may use this server.
# coolwsd consumes it as an alias group; the first comma-separated field of
# aliasgroup1 is a regex matched against the connecting WOPI host.
aliasgroup1=@%@domain@%@

# Config overrides without a dedicated environment variable go into
# extra_params; docker only honours the last occurrence of a variable in an
# env file, so all overrides must stay on this one line. The support key is
# synced by configure_host from the uploaded key file (/etc/collabora.key)
# into the UCR variable referenced here; an empty value is the same as no
# key. The other overrides are fed by the app settings.
extra_params=--o:support_key=@%@collabora/online/supportkey@%@ --o:ai.enabled=@%@collabora/ai@%@ --o:ai.api_url=@%@collabora/ai/apiurl@%@ --o:ai.api_key=@%@collabora/ai/apikey@%@ --o:ai.model=@%@collabora/ai/model@%@ --o:accessibility.enable=@%@collabora/accessibility@%@ --o:security.enable_macros_execution=@%@collabora/macros@%@ --o:languagetool.enabled=@%@collabora/languagetool/enabled@%@ --o:languagetool.base_url=@%@collabora/languagetool/baseurl@%@ --o:languagetool.user_name=@%@collabora/languagetool/username@%@ --o:languagetool.api_key=@%@collabora/languagetool/apikey@%@ --o:languagetool.rest_protocol=@%@collabora/languagetool/restprotocol@%@ --o:deepl.enabled=@%@collabora/deepl/enabled@%@ --o:deepl.api_url=@%@collabora/deepl/apiurl@%@ --o:deepl.auth_key=@%@collabora/deepl/authkey@%@ --o:remote_font_config.url=@%@collabora/fonts@%@
