# Environment file for docker container creation. The @%@...@%@ references
# are resolved from the app settings (and host UCR) when the container is
# created; coolwsd (started with --use-env-vars) reads the resulting
# variables at startup.

# The 'domain' setting is a regex of WOPI hosts that may use this server.
# coolwsd consumes it as an alias group; the first comma-separated field of
# aliasgroup1 is a regex matched against the connecting WOPI host.
aliasgroup1=@%@domain@%@

# Config overrides without a dedicated environment variable go into
# extra_params; docker only honours the last occurrence of a variable in an
# env file, so all overrides must stay on this one line. The support key is
# synced by configure_host from the uploaded key file (/etc/collabora.key)
# into the UCR variable referenced here; an empty value is the same as no
# key. collabora/ai is the AI master switch app setting.
extra_params=--o:support_key=@%@collabora/online/supportkey@%@ --o:ai.enabled=@%@collabora/ai@%@
